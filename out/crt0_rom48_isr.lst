                                    344 ;..............................................................................
                                    345 ; V9990 ISR
                           000000   346 .ifeq ROM_ISR-ISR_V9990
                                    347 .macro INCLUDE_ISR
                                    348 		.globl	_V9_InterruptVBlank
                                    349 		.globl	_V9_InterruptHBlank
                                    350 		.globl	_V9_InterruptCommand
                                    351 
                                    352 	crt0_interrupt_start::
                                    353 	; Skip interruptions that do not come from the VDP.
                                    354 		push	af
                                    355 		in		a, (V9_P06)
                                    356 		or		a
                                    357 		jr		z, crt0_interrupt_skip ; Quick skip (before full register backup)
                                    358 	; Backup registers
                                    359 		push	hl
                                    360 		push	de
                                    361 		push	bc
                                    362 		exx
                                    363 		ex		af, af'
                                    364 		push	af
                                    365 		push	hl
                                    366 		push	de
                                    367 		push	bc
                                    368 		push	iy
                                    369 		push	ix
                                    370 	; Call VDP interruption handler
                                    371 		in		a, (V9_P06)			; Get P#6 again (quicker than push/pop the value)
                                    372 		out		(V9_P06), a			; Reset interrupt bits
                                    373 	; V-Blank interruption
                                    374 		rra
                                    375 		call	c, _V9_InterruptVBlank
                                    376 	; H-Blank interruption
                                    377 		rra
                                    378 		call	c, _V9_InterruptHBlank
                                    379 	; Command end interruption
                                    380 		rra
                                    381 		call	c, _V9_InterruptCommand
                                    382 	; Restore registers
                                    383 		pop		ix
                                    384 		pop		iy

                                    305 		ld		a, #(0x80 + 15)
                                    306 		out		(VDP_A),a
                                    307 	.endif
                                    308 	; Check V-Blank
                                    309 		in		a, (VDP_S)					; Get S#0 value
                                    310 		rlca
                                    311 		call	c, _VDP_InterruptHandler 	; Call VDP interruption handler
                                    312 	; Check H-Blank
                                    313 		ld		a, #1
                                    314 		out		(VDP_A), a
                                    315 		ld		a, #(0x80 + 15)
                                    316 		out		(VDP_A), a

      000000                        495 _readInputControl::
                                    496 ;./the-castel.c:208: u8 row8 = Keyboard_Read(8);
      000000 2E 08            [ 7]  497 	ld	l, #0x08
                                    498 ;	spillPairReg hl
                                    499 ;	spillPairReg hl
      000002 CDr00r00         [17]  500 	call	_Keyboard_Read
      000005 4D               [ 4]  501 	ld	c, l
                                    502 ;./the-castel.c:210: g_Player.Input = 0;
      000006 11r05r03         [10]  503 	ld	de, #_g_Player+5
      000009 AF               [ 4]  504 	xor	a, a
                                    505 ;./the-castel.c:211: if (isMoveRight(row8, g_Player.Input))
      00000A 12               [ 7]  506 	ld	(de), a
      00000B 6F               [ 4]  507 	ld	l, a
                                    508 ;	spillPairReg hl
